# Copy to .env and adjust. Loaded by `make run` via your shell, or source
# it manually: `set -a; source .env; set +a` (bash) or load in your editor.

PORT=8080
AWS_REGION=us-east-1

# Real bucket/table names in production; whatever you like locally.
S3_BUCKET=archive-dev
DYNAMODB_TABLE=archive-items-dev

# Required on every request except /healthz (see the X-API-Key header).
# Any value works locally since nothing but you can reach localhost - use
# a long random value in production.
API_KEY=dev-key

# Leave unset in production. Point at the local containers from
# docker-compose.yml for local dev.
S3_ENDPOINT=http://localhost:9000
DYNAMODB_ENDPOINT=http://localhost:8000

# Local dev only: dummy credentials MinIO/DynamoDB Local accept.
# In production, don't set these at all — let the SDK pick up real
# credentials from an IAM role (see README).
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Cognito User Pool used to verify incoming Authorization: Bearer tokens
# (see internal/authtoken and the README's Auth section). Unlike S3/
# DynamoDB above, Cognito has no local emulator — local dev points at the
# same real User Pool production uses (see the README's "Local dev and
# Cognito" section for getting a test token without a real account).
COGNITO_USER_POOL_ID=
COGNITO_REGION=us-east-1

# Optional hardening: reject tokens not issued to this App Client. Leave
# unset to skip the check.
COGNITO_APP_CLIENT_ID=
