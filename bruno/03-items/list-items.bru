meta {
  name: list items
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/archives/{{archiveId}}/items?limit=20&sort=date:desc
  body: none
  auth: inherit
}

tests {
  test("returns a page envelope", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.data).to.be.an("array");
    expect(res.body.page.limit).to.equal(20);
  });

  test("cards are card-shaped", function () {
    // The index carries common metadata only - no files, notes or
    // attributes - which is what lets one query serve gallery, map and
    // timeline.
    if (res.body.data.length) {
      expect(res.body.data[0]).to.not.have.property("files");
    }
  });
}
