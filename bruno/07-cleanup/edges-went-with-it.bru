tests {
  test("no edge still names the deleted subject", function () {
    expect(res.getStatus()).to.equal(200);
    const dog = bru.getVar("dogId");
    res.body.data.forEach(function (e) {
      expect(e.fromSubjectId).to.not.equal(dog);
      expect(e.toSubjectId).to.not.equal(dog);
    });
  });
}
