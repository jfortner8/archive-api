meta {
  name: confirm again
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/archives/{{archiveId}}/items/{{itemId}}/files
  body: json
  auth: inherit
}

body:json {
  {
    "fileId": "{{fileId}}",
    "role": "photo",
    "key": "{{fileKey}}",
    "contentType": "image/png",
    "sizeBytes": 70
  }
}

tests {
  test("confirming twice attaches one file, not two", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.files).to.have.lengthOf(1);
  });
}

docs {
  Idempotent, because the server chose the file id before the upload rather
  than inventing one here. A retried confirmation is a retry, not a duplicate.
}
