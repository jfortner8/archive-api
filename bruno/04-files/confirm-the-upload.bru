meta {
  name: confirm the upload
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/archives/{{archiveId}}/items/{{itemId}}/files
  body: json
  auth: inherit
}

body:json {
  {
    "fileId": "{{fileId}}",
    "role": "photo",
    "key": "{{fileKey}}",
    "contentType": "image/png",
    "sizeBytes": 70,
    "originalFilename": "blue ridge scan.png"
  }
}

script:post-response {
  bru.setVar("itemEtag", res.getHeader("etag"));
}

tests {
  test("attaches the file", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.files).to.have.lengthOf(1);
  });

  test("a download URL comes back inline", function () {
    // The whole point: no second request per file. A gallery of 200 items
    // used to cost some 400 round trips before anything rendered.
    expect(res.body.files[0].url).to.be.a("string");
    expect(res.body.files[0].urlExpiresIn).to.be.above(0);
  });

  test("the cover is derived from the type's preference", function () {
    expect(res.body.coverFileId).to.equal(res.body.files[0].id);
  });
}
